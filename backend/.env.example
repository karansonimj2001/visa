# Django
SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Supabase (runtime — connection pooler URL for app queries)
DATABASE_URL=postgresql://postgres:your-password@db.supabase.co:6543/postgres

# Supabase (direct — migrations only)
SUPABASE_DB_DIRECT_URL=postgresql://postgres:your-password@db.supabase.co:5432/postgres

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here

# Stripe
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://yourdomain.com

# Storage
SUPABASE_STORAGE_BUCKET=visa-documents
